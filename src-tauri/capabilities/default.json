{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main, widget and quick-add windows (desktop)",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main", "quick", "w-*"],
  "permissions": [
    "core:default", "dialog:default",
    "core:window:allow-start-dragging", "core:window:allow-close", "core:window:allow-hide",
    "core:window:allow-set-focus", "core:window:allow-set-always-on-top"
  ]
}
